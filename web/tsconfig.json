{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["app", "remix.env.d.ts", "vite-env.d.ts"],
  "exclude": ["node_modules"]
}


